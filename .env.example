NODE_ENV=development
PORT=3000
# Public HTTPS URL in production (Meta needs it for webhooks and OAuth redirects)
APP_URL=http://localhost:3000
DATABASE_URL=postgres://app:app@localhost:5432/aireply
REDIS_URL=redis://localhost:6379
# docker-compose only (required there): long random values, e.g. openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# openssl rand -base64 32   — BACK THIS UP: losing it makes stored tokens unreadable
ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
# claude-opus-5-5 (best quality) or claude-haiku-5-5 (much cheaper)
AI_MODEL=claude-opus-5-5
AI_EFFORT=low

# Meta app → Settings → Basic
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
# Any long random string; enter the same value in the webhook settings
META_WEBHOOK_VERIFY_TOKEN=
# Facebook Login for Business → Configurations (WhatsApp Embedded Signup)
WA_EMBEDDED_SIGNUP_CONFIG_ID=
# Instagram → API setup with Instagram login → Instagram app ID / secret
IG_APP_ID=
IG_APP_SECRET=

# Telegram alerts (optional): bot from @BotFather; secret = long random [A-Za-z0-9_-]
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional. smtp://user:pass@host:587 — enables handoff email alerts and "forgot password"
SMTP_URL=
MAIL_FROM=AI Reply <no-reply@yourdomain.az>

LEGAL_COMPANY_NAME=
LEGAL_ADDRESS=
SUPPORT_EMAIL=
# Shown on the landing/login page, e.g. +994 50 000 00 00
CONTACT_PHONE=

RETENTION_DAYS=90
# Default monthly AI reply limit for new customers (editable per customer in /admin)
DEFAULT_REPLY_LIMIT=1000
