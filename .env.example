NODE_ENV=development
PORT=3000
# Public HTTPS URL in production (Meta needs it for webhooks and OAuth redirects)
APP_URL=http://localhost:3000
DATABASE_URL=postgres://app:app@localhost:5432/aireply
REDIS_URL=redis://localhost:6379
# Public domain for Caddy/TLS (docker-compose), DNS A record must point to the server
DOMAIN=
BACKUP_KEEP_DAYS=14
# docker-compose backups are encrypted to this age PUBLIC key (age1...). Create it on your own computer:
#   age-keygen -o age-key.txt   — keep age-key.txt OFF the server (password manager + offline copy)
BACKUP_AGE_RECIPIENT=
# Railway / separate DB roles: migrations use this owner URL, web/worker DATABASE_URL is the app_rw role (docs/DEPLOY.md §10)
# MIGRATE_DATABASE_URL=
# docker-compose only (required there): long random values, e.g. openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Least-privilege DB role for web/worker (letters/digits only): openssl rand -hex 24
APP_DB_PASSWORD=
# openssl rand -base64 32   — BACK THIS UP: losing it makes stored tokens unreadable
ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
# Models, prices and token budgets live in config/ai-models.json (routing.smart / routing.fast).
# Optional overrides: AI_MODEL=claude-opus-5-5  AI_MODEL_FAST=claude-haiku-5-5
AI_EFFORT=low
# on = short simple questions use the fast model; off = always the smart model
AI_ROUTING=on
# Max AI calls per business per minute
AI_WORKSPACE_RPM=30
# Max AI replies per conversation per hour (then staff takes over)
AI_CONV_HOURLY_CAP=30
# Minutes the AI stays silent after staff wrote in a conversation
HUMAN_PAUSE_MINUTES=60
# Photos/videos/voice messages are looked at before answering (needs ffmpeg; the Docker image has it)
MEDIA_ANALYSIS=on
# Speech-to-text for voice messages (Claude does not take audio). Any OpenAI-compatible endpoint, e.g.
# STT_API_URL=https://api.openai.com/v1/audio/transcriptions  STT_MODEL=whisper-1 (or gpt-4o-transcribe)
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-1
# Only while rotating ENCRYPTION_KEY: the old key (see docs/DEPLOY.md)
ENCRYPTION_KEY_PREVIOUS=

# Meta app → Settings → Basic
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
# Any long random string; enter the same value in the webhook settings
META_WEBHOOK_VERIFY_TOKEN=
# Facebook Login for Business → Configurations (WhatsApp Embedded Signup)
WA_EMBEDDED_SIGNUP_CONFIG_ID=
# Instagram → API setup with Instagram login → Instagram app ID / secret
IG_APP_ID=
IG_APP_SECRET=

# WhatsApp alerts (optional): your own WhatsApp Business number on the Cloud API + an approved
# UTILITY template with 3 body params: {{1}} business, {{2}} customer, {{3}} message
PLATFORM_WA_PHONE_NUMBER_ID=
PLATFORM_WA_TOKEN=
PLATFORM_WA_NUMBER=
PLATFORM_WA_TEMPLATE=
PLATFORM_WA_TEMPLATE_LANG=az
# Chrome/browser alerts (optional): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.az
# Telegram alerts (optional): bot from @BotFather; secret = long random [A-Za-z0-9_-]
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional. smtp://user:pass@host:587 — enables handoff email alerts and "forgot password"
SMTP_URL=
MAIL_FROM=AI Reply <no-reply@yourdomain.az>

LEGAL_COMPANY_NAME=
LEGAL_ADDRESS=
SUPPORT_EMAIL=
# Shown on the landing/login page, e.g. +994 50 000 00 00
CONTACT_PHONE=

RETENTION_DAYS=90
# Capacity per process (measured with scripts/loadtest.ts; see README "Tutum və yük testi")
WORKER_CONCURRENCY=100
INBOUND_CONCURRENCY=50
DB_POOL_MAX=20
# LOG_LEVEL=info
# Default monthly AI reply limit for new customers (editable per customer in /admin)
DEFAULT_REPLY_LIMIT=1000
